<view class="page welcome {{compact ? 'welcome-compact' : ''}}" style="{{pageStyle}}">
  <paper-background theme="sage" />
  <view class="brand"><view class="brand-mark" aria-hidden="true"><image wx:if="{{!logoFailed}}" class="brand-logo" src="/assets/paper/logo.png" mode="aspectFit" binderror="logoError"/><text wx:else class="brand-fallback">物</text></view><text class="brand-name">物物记</text><text class="brand-tag">小猫的收藏手账</text></view>
  <view class="intro"><view class="title">每件物品，<view>都有自己的故事。</view></view><view class="subtitle">记录陪伴的日子，也看看每天的花费。</view></view>
  <view class="welcome-art" style="{{heroStyle}}"><view class="art-paper art-paper-mint" aria-hidden="true"></view><view class="art-paper art-paper-lavender" aria-hidden="true"></view><image class="welcome-cat" src="/assets/stickers/collector.png" mode="aspectFit" aria-hidden="true"/><view class="art-note">慢慢用，好好记</view></view>
  <view class="sample-card"><view class="sample-top"><view><text class="sample-label">示例档案 · 非账户数据</text><view class="sample-name">一起去旅行的相机</view></view><text class="sample-stamp">陪伴中</text></view><view class="sample-metrics"><view class="sample-stat tone-holding"><text class="sample-caption">已陪伴</text><view class="sample-number">365<text class="sample-unit">天</text></view></view><view class="sample-stat tone-purchase"><text class="sample-caption">购买价 / 天</text><view class="sample-number">1.28<text class="sample-unit">元</text></view></view><view class="sample-tail"><text>小物件</text><text>大故事</text></view></view></view>
  <view class="welcome-footer"><button class="button paper-action" hover-class="button-hover" loading="{{busy}}" disabled="{{busy}}" bindtap="login" aria-label="{{busy ? '登录中' : devLogin ? '登录体验' : '微信登录'}}"><paper-label variant="login" text="{{busy ? '登录中…' : devLogin ? '登录体验' : '微信登录'}}"/></button><view wx:if="{{error}}" class="error" role="alert">{{error}}</view><view class="welcome-note">{{devLogin ? '开发者工具模拟登录' : '首次登录会建立独立的小程序账户'}}</view></view>
</view>
