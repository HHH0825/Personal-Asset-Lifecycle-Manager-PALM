.trash-top { display: flex; align-items: center; gap: 9px; }
.trash-info { flex: 1; min-width: 0; }
.trash-info .muted { margin-top: 3px; font-size: 11.5px; }
.expiry-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px; color: var(--ink-soft); font-size: 12.5px; background: var(--ledger); padding: 7.5px 9px; border-radius: 7px; margin: 12px 0 9px; }
.expiry-note { font-size: 11px; color: var(--muted); }
.trash-actions { display: flex; gap: 7px; }
.trash-actions .button { flex: 1; font-size: 13px; }
.cleanup-note { line-height: 1.7; font-size: 11.5px; margin-top: 13px; }
