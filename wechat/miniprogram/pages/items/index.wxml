<view class="page collection-page">
  <paper-background theme="sage" />
  <view class="page-heading heading-layout"><view class="heading-copy"><view class="eyebrow">物物记 · 私人物品档案</view><view class="title">我的物品</view><view class="subtitle">{{items.length}} 件，慢慢整理。</view></view><image class="heading-cat" src="/assets/stickers/camera.png" mode="aspectFit" aria-hidden="true"/></view>
  <view class="collection-toolbar"><paper-label variant="collection" text="收藏的小日常"/><button class="button add-button" hover-class="button-hover" bindtap="add" aria-label="新增物品"><paper-label variant="add" text="新增"/></button></view>
  <view class="filters"><view class="search-wrap"><text class="search-symbol">⌕</text><input class="search" placeholder="搜索名称、分类或备注" placeholder-class="search-placeholder" value="{{query}}" bindinput="search"/></view></view>
  <view class="filter-row"><picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="statusChange"><view class="select">{{statusOptions[statusIndex]}}<text>⌄</text></view></picker><picker range="{{categories}}" value="{{categoryIndex}}" bindchange="categoryChange"><view class="select"><text class="select-label">{{categories[categoryIndex]}}</text><text>⌄</text></view></picker></view>
  <view class="collection-tools"><picker range="{{sortOptions}}" value="{{sortIndex}}" bindchange="sortChange"><view class="sort-control">{{sortOptions[sortIndex]}} ⌄</view></picker><view class="view-switch"><button class="view-button {{layout === 'list' ? 'selected' : ''}}" data-layout="list" bindtap="changeLayout" aria-label="单列档案">档案</button><button class="view-button {{layout === 'wall' ? 'selected' : ''}}" data-layout="wall" bindtap="changeLayout" aria-label="双列照片墙">照片墙</button></view></view>
  <view class="result-row"><text>{{shown.length}} / {{items.length}} 件</text><button wx:if="{{query || status || category}}" class="clear-filter" bindtap="clearFilters">清除筛选</button></view>
  <view wx:if="{{error}}" class="card error-panel">{{error}}<button class="button light" bindtap="load">重新读取</button></view>
  <view wx:if="{{loading}}" class="empty"><text class="empty-mark">· · ·</text>正在读取物品…</view>
  <view wx:elif="{{!error && shown.length === 0}}" class="empty"><image class="empty-cat" src="{{items.length ? '/assets/stickers/search.png' : '/assets/stickers/collector.png'}}" mode="aspectFit" aria-hidden="true"/><text class="empty-title">{{items.length ? '没有符合条件的物品' : '先记录一件常用的物品'}}</text><view>{{items.length ? '换个关键词，或清除筛选。' : '照片、日期和花费，留在同一页。'}}</view><button wx:if="{{!items.length}}" class="button light" bindtap="add">添加物品</button></view>
  <view wx:else class="collection {{layout}}">
    <view wx:for="{{shown}}" wx:key="id" id="item-{{item.id}}" class="card item-card {{item.photo_url ? 'photo-target' : ''}}" data-id="{{item.id}}" bindtap="open">
      <view class="item-top"><view class="item-art"><image wx:if="{{photoPaths[item.id]}}" class="thumbnail" src="{{photoPaths[item.id]}}" mode="aspectFill" data-id="{{item.id}}" binderror="photoFailed"/><image wx:elif="{{!artErrors[item.id]}}" class="type-art" src="{{item.art}}" mode="aspectFit" data-id="{{item.id}}" binderror="artFailed"/><view wx:else class="art-symbol">{{item.icon}}</view><text wx:if="{{photoStates[item.id] === 'loading'}}" class="photo-loading">读取中…</text><button wx:if="{{photoStates[item.id] === 'error'}}" class="photo-retry" data-id="{{item.id}}" catchtap="retryPhoto" aria-label="重试照片">重试照片</button><view class="photo-corner corner-top"></view><view class="photo-corner corner-bottom"></view></view><view class="item-summary"><view class="archive-number">NO. {{item.id}}<text wx:if="{{item.is_pinned}}"> · 置顶</text></view><view class="item-name">{{item.name}}</view><view class="item-category">{{item.category}}</view><text class="pill status-{{item.status}}">{{item.statusText}}</text></view></view>
      <view wx:if="{{layout === 'list'}}" class="item-metrics"><view class="metric"><text class="metric-label">{{item.status === 'disposed' ? '曾持有' : '已持有'}}</text><view class="metric-value">{{item.holding_days}}<text class="metric-unit">天</text></view></view><view class="metric"><text class="metric-label">购买价 / 天</text><text class="metric-value">{{item.dailyPurchase}}</text></view><view class="metric"><text class="metric-label">净成本 / 天</text><text class="metric-value">{{item.dailyNet}}</text></view></view>
      <view wx:else class="wall-metrics"><text>{{item.status === 'disposed' ? '曾持有' : '陪伴'}} {{item.holding_days}} 天</text><text>净成本 / 天 {{item.dailyNet}}</text></view>
      <view class="item-footer"><text wx:if="{{layout === 'list'}}">累计净成本 ¥{{item.net_cost}}</text><text class="date-stamp">{{item.purchase_date}} 购入</text></view>
    </view>
  </view>
</view>
