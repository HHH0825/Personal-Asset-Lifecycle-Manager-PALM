<view class="page">
  <view class="page-heading heading-layout"><view class="heading-copy"><view class="eyebrow">物物记 · 我的收藏册</view><view class="title">我的物品</view><view class="subtitle">{{items.length}} 件物品，各有故事。</view></view><image class="heading-cat" src="/assets/stickers/camera.png" mode="aspectFit" aria-hidden="true"/></view>
  <view class="collection-toolbar"><text class="collection-tag">收藏的小日常</text><button class="button add-button" hover-class="button-hover" bindtap="add">＋ 新增</button></view>
  <view class="filters"><view class="search-wrap"><text class="search-symbol">⌕</text><input class="search" placeholder="搜索名称、分类或备注" placeholder-class="search-placeholder" value="{{query}}" bindinput="search"/></view><picker range="{{statusOptions}}" value="{{statusIndex}}" bindchange="statusChange"><view class="select">{{statusOptions[statusIndex]}}<text class="picker-caret">⌄</text></view></picker></view>
  <view wx:if="{{query || status}}" class="result-count muted">符合条件 {{shown.length}} / {{items.length}} 件</view>
  <view wx:if="{{error}}" class="card error-panel"><view>{{error}}</view><button class="button light" hover-class="button-hover" bindtap="load">重新读取</button></view>
  <view wx:elif="{{loading}}" class="empty"><text class="empty-mark">· · ·</text>正在翻开收藏册…</view>
  <view wx:elif="{{shown.length === 0}}" class="empty"><image class="empty-cat" src="{{items.length ? '/assets/stickers/search.png' : '/assets/stickers/collector.png'}}" mode="aspectFit" aria-hidden="true"/><text class="empty-title">{{items.length ? '还没有找到它' : '先收藏第一件物品吧'}}</text><view>{{items.length ? '试试其他关键词或状态。' : '从一件常用的小物开始，记下它的故事。'}}</view><button wx:if="{{!items.length}}" class="button light" hover-class="button-hover" bindtap="add">添加物品</button></view>
  <block wx:else>
    <view wx:for="{{shown}}" wx:key="id" class="card item-card {{item.photo_url ? 'photo-target' : ''}}" data-id="{{item.id}}" bindtap="open">
      <view class="item-top"><view class="item-art"><image wx:if="{{photoPaths[item.id]}}" class="thumbnail" src="{{photoPaths[item.id]}}" mode="aspectFill" data-id="{{item.id}}" binderror="photoFailed"/><view wx:else class="icon">{{item.icon}}</view></view><view class="item-summary"><view class="item-name">{{item.name}}</view><view class="item-category">{{item.category}}<text wx:if="{{item.is_pinned}}" class="pin-note"> · 置顶</text></view></view><text class="pill status-{{item.status}}">{{item.statusText}}</text></view>
      <view class="item-metrics"><view class="metric tone-holding"><text class="metric-label">{{item.status === 'disposed' ? '曾持有' : '已持有'}}</text><view class="metric-value">{{item.holding_days}}<text class="metric-unit">天</text></view></view><view class="metric tone-purchase"><text class="metric-label">购买价 / 天</text><text class="metric-value">{{item.dailyPurchase}}</text></view><view class="metric tone-net"><text class="metric-label">净成本 / 天</text><text class="metric-value">{{item.dailyNet}}</text></view></view>
      <view class="item-footer"><text>累计净成本 ¥{{item.net_cost}}</text><text>{{item.purchase_date}} 购入</text></view>
    </view>
  </block>
</view>
