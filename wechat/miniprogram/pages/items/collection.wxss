.collection-toolbar { display:flex; justify-content:space-between; align-items:center; gap:12px; margin: -6px 0 14px; }
.collection-toolbar > paper-label { flex:0 0 142px; width:142px; }
.collection-toolbar .add-button { flex:0 0 104px; width:104px; max-width:104px; min-width:0; height:46px; min-height:46px; margin:0 0 0 auto; padding:0; background:transparent; border-radius:0; }
.filters { margin-bottom:8px; }
.search-wrap { display:flex; align-items:center; background:var(--paper); border:.5px solid var(--line); border-radius:8px; padding:0 10px; }
.search-symbol { color:var(--muted); margin-right:8px; }
.search { flex:1; width:0; min-height:44px; font-size:13px; }
.search-placeholder { color:var(--muted); }
.filter-row { display:flex; gap:8px; }
.filter-row picker { flex:1; min-width:0; }
.select { display:flex; align-items:center; justify-content:space-between; gap:6px; min-height:44px; padding:0 10px; border-bottom:1px solid var(--line); font-size:12px; }
.select-label { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.collection-tools,.result-row { display:flex; justify-content:space-between; align-items:center; gap:8px; }
.collection-tools { margin-top:8px; }
.collection-tools picker { flex:1; min-width:0; }
.sort-control { min-height:44px; line-height:44px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:11px; color:var(--muted); }
.view-switch { display:flex; flex:0 0 136px; border:1px solid var(--line); border-radius:6px; overflow:hidden; }
.view-button { width:68px; max-width:68px; flex:none; margin:0; padding:0 8px; min-height:44px; line-height:44px; border-radius:0; font-size:12px; color:var(--muted); background:var(--paper); }
.view-button::after,.clear-filter::after { border:0; }
.view-button.selected { background:var(--sage); color:var(--mint-ink); font-weight:600; }
.result-row { min-height:32px; color:var(--muted); font-size:11px; }
.clear-filter { margin:0; padding:0 3px; line-height:32px; font-size:11px; color:var(--accent); background:transparent; }
.item-card { padding:14px; margin:0 0 12px; border-radius:10px; }
.item-top { display:flex; align-items:flex-start; gap:14px; }
.item-art { position:relative; flex:none; width:80px; height:80px; background:var(--ledger); }
.thumbnail,.type-art { width:100%; height:100%; display:block; }
.type-art { box-sizing:border-box; padding:8px; }
.art-symbol { display:flex; height:100%; align-items:center; justify-content:center; font-size:26px; }
.photo-corner { position:absolute; width:10px; height:10px; pointer-events:none; border-color:var(--tape); border-style:solid; }
.corner-top { top:0; left:0; border-width:3px 0 0 3px; }
.corner-bottom { bottom:0; right:0; border-width:0 3px 3px 0; }
.item-summary { flex:1; min-width:0; }
.archive-number { font-size:9px; color:var(--muted); letter-spacing:1px; margin-bottom:3px; }
.item-name { font-size:16px; font-weight:600; overflow-wrap:anywhere; }
.item-category { color:var(--muted); font-size:11px; margin:4px 0 6px; overflow-wrap:anywhere; }
.item-summary .pill { font-size:10px; padding:2px 6px; }
.item-metrics { display:flex; padding:10px 0; margin:14px 0 10px; background:var(--ledger); border-radius:4px; }
.item-metrics .metric { padding:0 8px; box-sizing:border-box; }
.item-metrics .metric + .metric { border-left:.5px solid var(--line); }
.item-metrics .metric-value { font-size:14px; }
.item-footer { display:flex; flex-wrap:wrap; justify-content:space-between; gap:5px; color:var(--muted); font-size:10px; }
.date-stamp { font-variant-numeric:tabular-nums; }
.wall { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:10px; }
.wall .item-card { margin:0; padding:9px; display:flex; flex-direction:column; min-width:0; }
.wall .item-top { display:block; }
.wall .item-art { width:100%; height:0; padding-bottom:100%; margin-bottom:10px; }
.wall .thumbnail,.wall .type-art,.wall .art-symbol { position:absolute; top:0; left:0; width:100%; height:100%; }
.wall .type-art { padding:18px; }
.wall .item-name { font-size:14px; line-height:1.45; height:2.9em; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
.wall .item-category { display:none; }
.wall .pill { margin-top:6px; }
.wall-metrics { margin:10px 0; font-size:11px; line-height:1.8; overflow-wrap:anywhere; }
.wall-metrics text { display:block; }
.wall .item-footer { margin-top:auto; font-size:9px; }
@media (max-width:350px) { .item-card { padding:11px; } .item-top { gap:10px; } .item-metrics .metric { padding:0 5px; } .item-metrics .metric-value { font-size:12px; } .item-metrics .metric-label { font-size:10px; } .view-button { padding:0 8px; } .wall { gap:8px; } }
