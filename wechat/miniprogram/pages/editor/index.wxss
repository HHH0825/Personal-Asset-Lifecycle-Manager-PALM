.warranty-label { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
.clear-date { color: var(--accent); font-size: 11.5px; padding: 4px 0 4px 10px; }
.photo-choice { display: flex; align-items: center; gap: 11px; padding: 5px 0; }
.preview, .photo-placeholder { width: 60px; height: 60px; border-radius: 10px; flex: none; }
.photo-placeholder { background: var(--ledger); color: var(--ink-soft); text-align: center; line-height: 60px; font-size: 21px; }
.photo-label { font-size: 14px; color: var(--ink); margin-bottom: 3px; }
.photo-copy { flex: 1; min-width: 0; }
.photo-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
.photo-actions .button { margin: 0; font-size: 13px; padding: 8px 12px; }
.photo-error { margin-top: 10px; font-size: 12px; line-height: 1.6; color: var(--danger); overflow-wrap: anywhere; }
.photo-error .button { margin: 7px 0 0; }
.photo-edit-canvas { position: absolute; left: -10000px; top: 0; width: 1px; height: 1px; pointer-events: none; }
.draft-note { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:4px 12px; color:var(--muted); font-size:12px; line-height:1.6; margin:12px 0; }
.draft-discard { min-height:44px; margin:0; padding:8px 0; background:transparent; color:var(--ink-soft); font-size:12px; line-height:28px; }
.draft-discard::after { border:none; }
.draft-overlay { position:fixed; inset:0; z-index:100; background:rgba(73,59,53,.36); display:flex; align-items:center; justify-content:center; padding:20px; box-sizing:border-box; }
.draft-dialog { width:100%; max-width:360px; max-height:80vh; overflow:auto; background:var(--paper); border:1px solid var(--line); border-radius:16px; padding:20px; box-sizing:border-box; }
.draft-title { margin-top:16px; overflow-wrap:anywhere; font-size:17px; line-height:1.5; }
