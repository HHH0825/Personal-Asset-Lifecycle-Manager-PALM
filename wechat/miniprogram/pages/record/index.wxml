<view class="page">
  <paper-background theme="small" />
  <view class="page-heading heading-layout"><view class="heading-copy"><view class="eyebrow">物物记 · 生命周期</view><view class="title">{{retired ? '历史使用记录' : kind === 'maintenance' ? '维修记录' : '处置记录'}}</view><view class="subtitle">{{retired ? '使用记录已停用，历史内容保留在详情底部。' : kind === 'maintenance' ? '记下修复，也记下继续陪伴的成本。' : '好好记录，这一次的告别。'}}</view></view><image class="heading-cat" src="/assets/stickers/journal.png" mode="aspectFit" aria-hidden="true"/></view>
  <view wx:if="{{retired}}" class="card"><view class="journal-note">不再新增或修改使用记录。</view><button class="button light" bindtap="back">返回物品</button></view>
  <view wx:elif="{{loading}}" class="empty"><text class="empty-mark">· · ·</text>正在读取记录…</view>
  <view wx:elif="{{loadFailed}}" class="card error-panel">{{error}}<button class="button light" hover-class="button-hover" bindtap="load">重新读取</button></view>
  <block wx:else>
    <view class="card form-card">
      <block wx:if="{{kind === 'maintenance'}}"><view class="field"><text class="field-label">维修日期</text><picker mode="date" value="{{form.maintained_on}}" end="{{today}}" data-key="maintained_on" bindchange="input"><view class="picker"><text>{{form.maintained_on}}</text><text class="picker-caret">⌄</text></view></picker></view><view class="field"><text class="field-label">维修费用 <text class="optional">元</text></text><input class="{{focusField === 'cost' ? 'is-focused' : ''}}" type="digit" value="{{form.cost}}" data-key="cost" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="0.00" placeholder-class="field-placeholder" aria-label="维修费用"/></view><view class="field"><text class="field-label">维修说明</text><input class="{{focusField === 'description' ? 'is-focused' : ''}}" value="{{form.description}}" maxlength="500" data-key="description" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="例如：更换电池" placeholder-class="field-placeholder" aria-label="维修说明"/></view></block>
      <block wx:else><view class="field"><text class="field-label">处置日期</text><picker mode="date" value="{{form.disposed_on}}" end="{{today}}" data-key="disposed_on" bindchange="input"><view class="picker"><text>{{form.disposed_on}}</text><text class="picker-caret">⌄</text></view></picker></view><view class="field"><text class="field-label">处置方式</text><picker range="{{methods}}" value="{{methodIndex}}" bindchange="methodChange"><view class="picker"><text>{{methods[methodIndex]}}</text><text class="picker-caret">⌄</text></view></picker></view><view class="field"><text class="field-label">回收金额 <text class="optional">元</text></text><input class="{{focusField === 'proceeds' ? 'is-focused' : ''}}" type="digit" value="{{form.proceeds}}" data-key="proceeds" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="没有回收金额时填写 0" placeholder-class="field-placeholder" aria-label="回收金额"/></view><view class="field"><text class="field-label">备注 <text class="optional">可选</text></text><textarea class="{{focusField === 'notes' ? 'is-focused' : ''}}" value="{{form.notes}}" maxlength="1000" data-key="notes" bindinput="input" bindfocus="focus" bindblur="blur" cursor-spacing="24" placeholder="记下这次告别" placeholder-class="field-placeholder" aria-label="处置备注"/></view></block>
    </view>
    <view wx:if="{{error}}" class="card error-panel">{{error}}</view><button class="button block" hover-class="button-hover" bindtap="save" disabled="{{busy || loading}}" loading="{{busy}}">保存记录</button><button wx:if="{{recordId}}" class="button warn block" hover-class="button-hover" bindtap="remove">删除记录</button>
  </block>
</view>
