.detail-cover { position: relative; padding: 12px; background: var(--paper); border: .5px solid var(--line); border-radius: var(--radius); box-shadow: 3px 4px 0 rgba(73, 59, 53, .04); }
.detail-cover::before { content: ''; position: absolute; pointer-events: none; top: -5px; right: 26px; width: 42px; height: 11px; background: var(--yellow); transform: rotate(5deg); border-radius: 2px; }
.cover-label { font-size: 10px; color: var(--muted); letter-spacing: 1px; margin-bottom: 9px; }
.detail-hero { border-radius: 11px; overflow: hidden; background: var(--blue-soft); }
.photo { display: block; width: 100%; height: 200px; }
.detail-no-photo { height: 120px; display: flex; flex-direction: column; align-items: center; justify-content: center; position: relative; color: var(--muted); font-size: 11.5px; }
.detail-symbol { font-size: 35px; color: var(--blue); line-height: 1.2; }
.detail-art-line { width: 30px; height: 2px; border-radius: 2px; background: var(--primary); margin: 7.5px 0; }
.detail-heading { margin: 12.5px 0; }
.detail-heading .row { justify-content: flex-start; flex-wrap: wrap; }
.detail-heading .title { font-size: 22px; margin-top: 7px; }
.cost-card { padding: 14px; }
.cost-heading { display: flex; align-items: center; justify-content: space-between; gap: 6px; margin-bottom: 12px; }
.cost-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 0; background: var(--ledger); border-radius: 8px; overflow: hidden; }
.cost-grid .metric { padding: 10px; box-sizing: border-box; }
.cost-grid .metric:nth-child(even) { border-left: 0.5px solid var(--line); }
.cost-grid .metric:nth-child(n+3) { border-top: 0.5px solid var(--line); }
.cost-grid .metric-value { font-size: 18.5px; }
.fact-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 7.5px 0; font-size: 13.5px; border-bottom: 0.5px solid var(--line); }
.fact-row:first-child { padding-top: 0; }
.fact-label { color: var(--muted); font-size: 12px; flex: none; }
.fact-note { margin-top: 9px; font-size: 13.5px; line-height: 1.7; overflow-wrap: anywhere; }
.fact-note view { margin-top: 5px; }
.actions { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
.actions .button { flex: 1; min-width: 85px; padding: 8px 9px; font-size: 12.5px; }
.record-actions .button.block { margin-top: 0; }
.secondary-actions .button { min-width: 77.5px; }
.timeline { padding-left: 14px; margin: 13px 0; }
.timeline-entry { position: relative; border-left: 1px solid var(--line); padding: 0 0 12px 14px; }
.timeline-entry:last-child { padding-bottom: 0; }
.timeline-dot { position: absolute; left: -5px; top: 4px; width: 8px; height: 8px; border-radius: 50%; background: var(--mint-ink); border: 1px solid var(--bg); }
.event-date { color: var(--muted); font-size: 11.5px; }
.event { margin: 6px 0 0; padding: 12px; }
.event-kind { color: var(--mint-ink); font-size: 13px; font-weight: 600; }
.event-usage .event { background: var(--paper); }
.event-maintenance .event { background: var(--paper); }
.event-maintenance .timeline-dot { background: var(--peach-ink); }
.event-maintenance .event-kind { color: var(--peach-ink); }
.event-disposal .event { background: var(--paper); }
.event-disposal .timeline-dot { background: var(--neutral-ink); }
.event-disposal .event-kind { color: var(--neutral-ink); }
.event .muted { color: var(--ink-soft); }
.event-text { margin-top: 6px; line-height: 1.6; overflow-wrap: anywhere; font-size: 13.5px; }
@media (max-width: 350px) { .cost-grid .metric-value { font-size: 15.5px; } .cost-grid .metric { padding: 8px; } }
