<view class="page detail-page">
  <paper-background theme="small" />
  <view wx:if="{{loading}}" class="empty"><text class="empty-mark">· · ·</text>正在翻开这一页…</view>
  <view wx:elif="{{error}}" class="card error-panel">{{error}}<button class="button light" hover-class="button-hover" bindtap="load">重新读取</button></view>
  <block wx:elif="{{item}}">
    <view class="detail-cover"><view class="cover-label">物品档案</view><view class="detail-hero"><image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFill" binderror="photoFailed"/><view wx:else class="detail-no-photo"><image wx:if="{{!artFailed}}" class="detail-type-art" src="{{item.art}}" mode="aspectFit" binderror="artFailed"/><view wx:else class="detail-symbol">{{item.icon}}</view><view class="detail-art-line"></view><text>暂无照片</text></view></view></view>
    <view class="detail-heading"><view class="row"><text class="pill status-{{item.status}}">{{item.statusText}}</text><text class="muted small">{{item.category}}</text></view><view class="title">{{item.name}}</view><view class="subtitle">{{item.purchase_date}} 购入 · ¥{{item.purchase_price}}</view></view>
    <view class="card cost-card"><view class="cost-heading"><text class="section-title">陪伴与花费</text><text class="section-note">历史成本均摊</text></view><view class="cost-grid"><view class="metric tone-holding"><text class="metric-label">{{item.status === 'disposed' ? '曾持有' : '已持有'}}</text><view class="metric-value">{{item.holding_days}}<text class="metric-unit">天</text></view></view><view class="metric tone-purchase"><text class="metric-label">购买价 / 天</text><text class="metric-value">{{item.dailyPurchase}}</text></view><view class="metric tone-net"><text class="metric-label">净成本 / 天</text><text class="metric-value">{{item.dailyNet}}</text></view><view class="metric tone-total"><text class="metric-label">累计净成本</text><text class="metric-value">¥{{item.net_cost}}</text></view></view></view>
    <view class="card journey-card"><view class="section-title">陪伴纪念</view>
      <view wx:if="{{stamps.length}}" class="seal-row"><view wx:for="{{stamps}}" wx:key="id" class="date-seal"><text class="seal-label">{{item.label}}</text><text>{{item.date}}</text></view></view>
      <view wx:else class="journal-note">还没有达成的纪念。</view>
      <button wx:if="{{allStamps.length > 3}}" class="journal-link" bindtap="toggleStamps">{{expanded ? '收起' : '查看全部纪念'}}</button>
      <view wx:if="{{item.milestones.next}}" class="journal-note">下一次：{{item.milestones.next.label}} · {{item.milestones.next.date}}<view>还有 {{item.milestones.next.remaining_days}} 天</view></view>
      <view wx:if="{{item.status === 'disposed'}}" class="journal-note">纪念截至处置日。</view>
      <view class="journal-rule"></view><view class="section-title">日均小目标</view>
      <view wx:if="{{item.daily_target}}" class="target-summary"><view>购买价均摊到每天 ¥{{item.daily_target.amount}}</view><view class="journal-caption">当前购买价 / 天：{{item.dailyPurchase}}</view><view class="target-track"><view class="target-fill" style="width:{{item.daily_target.progress_percent}}%;"></view></view><view class="journal-note">{{item.daily_target.status === 'reached' ? '已达到 · ' + item.daily_target.reached_on : item.daily_target.status === 'closed' ? '已处置，目标结束' : item.daily_target.estimated_date ? '预计 ' + item.daily_target.estimated_date + ' 达到，还需 ' + item.daily_target.remaining_days + ' 天' : '目标日期超出可显示范围'}}</view></view>
      <view wx:else class="journal-note">为购买价设一个每天均摊的小目标。</view>
      <view class="journal-note">仅按购买价和持有天数计算，不代表实际省下的金额。</view>
      <button wx:if="{{item.status !== 'disposed' && !targetEditing}}" class="journal-link" bindtap="editTarget">{{item.daily_target ? '修改目标' : '设置目标'}}</button>
      <view wx:if="{{targetEditing && item.status !== 'disposed'}}" class="target-form"><view class="field"><text class="field-label">目标购买价 / 天（元）</text><input type="digit" value="{{targetInput}}" bindinput="targetInput" placeholder="例如：5.00" disabled="{{targetBusy}}" cursor-spacing="24"/></view><view wx:if="{{targetError}}" class="error">{{targetError}}</view><view class="actions"><button class="button" bindtap="saveTarget" disabled="{{targetBusy}}" loading="{{targetBusy}}">保存目标</button><button class="button light" bindtap="closeTarget" disabled="{{targetBusy}}">暂不修改</button></view><button wx:if="{{item.daily_target}}" class="journal-link" bindtap="cancelTarget" disabled="{{targetBusy}}">取消这个目标</button></view>
    </view>
    <view class="section-head"><text class="section-title">基本资料</text><text class="section-note">物品档案</text></view>
    <view class="card facts"><view class="fact-row"><text class="fact-label">维修合计</text><text>¥{{item.maintenance_total}}</text></view><view class="fact-row"><text class="fact-label">处置回收</text><text>¥{{item.disposal_proceeds}}</text></view><view class="fact-row"><text class="fact-label">保修到期</text><text>{{item.warranty_expires_on || '未填写'}}</text></view><view class="fact-row"><text class="fact-label">记录的使用</text><text>{{item.usage_count}} 次</text></view><view class="fact-note"><text class="fact-label">备注</text><view>{{item.notes || '暂无备注'}}</view></view></view>
    <view class="actions"><button class="button light" hover-class="button-hover" bindtap="edit">编辑物品</button><button class="button light" hover-class="button-hover" bindtap="togglePin">{{item.is_pinned ? '取消置顶' : '置顶'}}</button><button wx:if="{{photoPath}}" class="button light" hover-class="button-hover" bindtap="removePhoto">移除照片</button></view>
    <view class="section-head"><view class="row"><image class="tiny-cat" src="/assets/stickers/journal.png" mode="aspectFit" aria-hidden="true"/><text class="section-title">使用与维护</text></view><text class="section-note">生命周期记录</text></view>
    <view wx:if="{{item.status !== 'disposed'}}" class="record-actions"><button class="button block" hover-class="button-hover" bindtap="quickUse" disabled="{{busy}}">{{item.used_today ? '今天已记录使用' : '今天用过，记一下'}}</button><view class="actions secondary-actions"><button class="button light" hover-class="button-hover" data-kind="usage" bindtap="record">补记使用</button><button class="button light" hover-class="button-hover" data-kind="maintenance" bindtap="record">记一笔维修</button><button class="button light" hover-class="button-hover" data-kind="disposal" bindtap="record">记录处置</button></view></view>
    <view wx:if="{{timeline.length === 0}}" class="empty"><image class="empty-cat" src="/assets/stickers/journal.png" mode="aspectFit" aria-hidden="true"/>还没有使用或维护记录。</view>
    <view class="timeline"><view wx:for="{{timeline}}" wx:key="key" class="timeline-entry event-{{item.kind}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editRecord"><view class="timeline-dot"></view><view class="event-date">{{item.day}}</view><view class="card event"><view class="row"><text class="event-kind">{{item.kindText}}</text><text class="muted small">编辑 ›</text></view><view class="event-text">{{item.text}}</view></view></view></view>
    <button class="button warn block" hover-class="button-hover" bindtap="remove">移入回收站</button>
  </block>
</view>
