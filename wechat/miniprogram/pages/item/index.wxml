<view class="page detail-page">
  <paper-background theme="small" />
  <view wx:if="{{loading}}" class="empty"><text class="empty-mark">· · ·</text>正在翻开这一页…</view>
  <view wx:elif="{{error}}" class="card error-panel">{{error}}<button class="button light" hover-class="button-hover" bindtap="load">重新读取</button></view>
  <block wx:elif="{{item}}">
    <view wx:if="{{item.photo_url}}" class="detail-cover"><view class="cover-label">物品档案 · {{item.id}}</view><view class="detail-hero"><image wx:if="{{photoPath}}" class="photo" src="{{photoPath}}" mode="aspectFill" binderror="photoFailed"/><view wx:else class="detail-no-photo">照片暂未显示</view></view></view>
    <view class="detail-heading {{!item.photo_url ? 'compact-heading' : ''}}">
      <view wx:if="{{!item.photo_url}}" class="compact-art"><image wx:if="{{!artFailed}}" class="detail-type-art" src="{{item.art}}" mode="aspectFit" binderror="artFailed"/><view wx:else class="detail-symbol">{{item.icon}}</view></view>
      <view class="heading-text"><view class="row"><text class="pill status-{{item.status}}">{{item.statusText}}</text><text class="muted small">{{item.category}}</text></view><view class="title">{{item.name}}</view><view class="subtitle">{{item.purchase_date}} 购入 · ¥{{item.purchase_price}}</view></view>
    </view>
    <view class="card cost-card"><view class="cost-heading"><text class="section-title">陪伴与花费</text><text class="section-note">历史成本均摊</text></view><view class="cost-grid"><view class="metric tone-holding"><text class="metric-label">{{item.status === 'disposed' ? '曾持有' : '已持有'}}</text><view class="metric-value">{{item.holding_days}}<text class="metric-unit">天</text></view></view><view class="metric tone-purchase"><text class="metric-label">购买价 / 天</text><text class="metric-value">{{item.dailyPurchase}}</text></view><view class="metric tone-net"><text class="metric-label">净成本 / 天</text><text class="metric-value">{{item.dailyNet}}</text></view><view class="metric tone-total"><text class="metric-label">累计净成本</text><text class="metric-value">¥{{item.net_cost}}</text></view></view></view>
    <view class="detail-shortcuts"><view class="actions"><button class="button light" hover-class="button-hover" bindtap="edit" disabled="{{busy || targetBusy}}">编辑物品</button><button class="button light" hover-class="button-hover" bindtap="more" disabled="{{busy || targetBusy}}">更多操作 ···</button></view></view>
    <view class="card journey-card"><view class="section-title">陪伴纪念</view>
      <view wx:if="{{stamps.length}}" class="seal-row"><view wx:for="{{stamps}}" wx:key="id" class="date-seal"><text class="seal-label">{{item.label}}</text><text>{{item.date}}</text></view></view>
      <view wx:else class="journal-note">还没有达成的纪念。</view>
      <button wx:if="{{allStamps.length > 1}}" class="journal-link" bindtap="toggleStamps" aria-expanded="{{expanded}}">{{expanded ? '收起纪念' : '查看全部 ' + allStamps.length + ' 枚纪念'}}</button>
      <view wx:if="{{item.milestones.next}}" class="journal-note">下一次：{{item.milestones.next.label}} · {{item.milestones.next.date}}<view>还有 {{item.milestones.next.remaining_days}} 天</view></view>
      <view wx:if="{{item.status === 'disposed'}}" class="journal-note">纪念截至处置日。</view>
      <view class="journal-rule"></view><view wx:if="{{item.daily_target || targetEditing}}" class="section-title">日均小目标</view>
      <view wx:if="{{item.daily_target}}" class="target-summary"><view>购买价均摊到每天 ¥{{item.daily_target.amount}}</view><view class="journal-caption">当前购买价 / 天：{{item.dailyPurchase}}</view><view class="target-track"><view class="target-fill" style="width:{{item.daily_target.progress_percent}}%;"></view></view><view class="journal-note">{{item.daily_target.status === 'reached' ? '已达到 · ' + item.daily_target.reached_on : item.daily_target.status === 'closed' ? '已处置，目标结束' : item.daily_target.estimated_date ? '预计 ' + item.daily_target.estimated_date + ' 达到，还需 ' + item.daily_target.remaining_days + ' 天' : '目标日期超出可显示范围'}}</view></view>
      <view wx:if="{{item.daily_target || targetEditing}}" class="journal-note">按购买价 ÷ 持有天数计算，不代表实际省钱。</view>
      <button wx:if="{{item.status !== 'disposed' && !targetEditing}}" class="journal-link" bindtap="editTarget">{{item.daily_target ? '修改目标' : '设置日均小目标 ›'}}</button>
      <view wx:if="{{targetEditing && item.status !== 'disposed'}}" class="target-form"><view class="field"><text class="field-label">目标购买价 / 天（元）</text><input type="digit" value="{{targetInput}}" bindinput="targetInput" placeholder="例如：5.00" disabled="{{targetBusy}}" cursor-spacing="24"/></view><view wx:if="{{targetError}}" class="error">{{targetError}}</view><view class="actions"><button class="button" bindtap="saveTarget" disabled="{{targetBusy}}" loading="{{targetBusy}}">保存目标</button><button class="button light" bindtap="closeTarget" disabled="{{targetBusy}}">暂不修改</button></view><button wx:if="{{item.daily_target}}" class="journal-link" bindtap="cancelTarget" disabled="{{targetBusy}}">取消这个目标</button></view>
    </view>
    <view class="card facts"><button class="fold-heading" bindtap="toggleFacts" aria-expanded="{{factsExpanded}}"><text class="section-title">基本资料</text><text class="section-note">{{factsExpanded ? '收起 −' : '展开 +'}}</text></button><view wx:if="{{factsExpanded}}" class="facts-body"><view class="fact-row"><text class="fact-label">维修合计</text><text>¥{{item.maintenance_total}}</text></view><view class="fact-row"><text class="fact-label">处置回收</text><text>¥{{item.disposal_proceeds}}</text></view><view class="fact-row"><text class="fact-label">保修到期</text><text>{{item.warranty_expires_on || '未填写'}}</text></view><view class="fact-note"><text class="fact-label">备注</text><view>{{item.notes || '暂无备注'}}</view></view></view></view>
    <view class="section-head"><text class="section-title">维修与处置</text><text class="section-note">共 {{allTimeline.length}} 条记录</text></view>
    <view wx:if="{{item.status !== 'disposed'}}" class="actions secondary-actions"><button class="button light" hover-class="button-hover" data-kind="maintenance" bindtap="record" disabled="{{busy || targetBusy}}">记一笔维修</button><button class="button light" hover-class="button-hover" data-kind="disposal" bindtap="record" disabled="{{busy || targetBusy}}">记录处置</button></view>
    <view wx:if="{{allTimeline.length === 0}}" class="compact-empty">还没有维修或处置记录。</view>
    <view class="timeline"><view wx:for="{{timeline}}" wx:key="key" class="timeline-entry event-{{item.kind}}" data-id="{{item.id}}" data-kind="{{item.kind}}" bindtap="editRecord"><view class="timeline-dot"></view><view class="event-date">{{item.day}}</view><view class="card event"><view class="row"><text class="event-kind">{{item.kindText}}</text><text class="muted small">编辑 ›</text></view><view class="event-text">{{item.text}}</view></view></view></view>
    <button wx:if="{{allTimeline.length > 3}}" class="journal-link" bindtap="toggleTimeline" aria-expanded="{{timelineExpanded}}">{{timelineExpanded ? '收起记录' : '查看全部 ' + allTimeline.length + ' 条记录'}}</button>
    <view wx:if="{{historyUsage.length}}" class="card usage-history"><button class="fold-heading" bindtap="toggleHistory" aria-expanded="{{historyExpanded}}"><text class="section-title">历史使用记录</text><text class="section-note">{{historyExpanded ? '收起 −' : '查看 +'}}</text></button><block wx:if="{{historyExpanded}}"><view class="journal-caption">保留以前录入的内容，仅供查看。</view><view wx:for="{{historyUsage}}" wx:key="id" class="history-entry"><text class="event-date">{{item.used_on}}</text><view class="event-text">{{item.notes || '记录了一次使用'}}</view></view></block></view>
  </block>
</view>
