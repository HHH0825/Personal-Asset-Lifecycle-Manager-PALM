<view class="page">
  <paper-background theme="rose" />
  <view class="page-heading heading-layout"><view class="heading-copy"><view class="eyebrow">物物记 · 从记录中发现</view><view class="row"><view class="title">小小发现</view><text class="pill">基于规则生成</text></view><view class="subtitle">按记录整理，看看哪些物品值得留意。</view></view><view class="discovery-art" aria-hidden="true"><image class="heading-cat" src="/assets/stickers/journal.png" mode="aspectFit"/><text class="discovery-stamp">生活收藏</text></view></view>
  <view wx:if="{{statsError}}" class="card error-panel" role="alert">统计读取失败：{{statsError}}<button class="button light" hover-class="button-hover" bindtap="loadStats">重新读取统计</button></view>
  <view wx:elif="{{statsLoading}}" class="card muted"><text>正在整理统计…</text></view>
  <view wx:elif="{{stats}}" class="card totals"><view class="total-main"><view><text class="metric-label">我的物品</text><view class="total-number">{{stats.total_items}}<text class="metric-unit">件</text></view></view><view class="total-cost"><text class="metric-label">累计净成本</text><text class="total-number">¥{{stats.net_cost_total}}</text></view></view><view class="total-breakdown"><view><text class="metric-label">购买支出</text><text class="breakdown-value">¥{{stats.purchase_total}}</text></view><view><text class="metric-label">维修支出</text><text class="breakdown-value">¥{{stats.maintenance_total}}</text></view><view><text class="metric-label">处置回收</text><text class="breakdown-value">¥{{stats.disposal_total}}</text></view></view></view>
  <view class="section-head"><text class="section-title">值得留意的事</text><text class="section-note">来自你的记录</text></view>
  <view wx:if="{{cardsError}}" class="card error-panel" role="alert">分析读取失败：{{cardsError}}<button class="button light" hover-class="button-hover" bindtap="loadCards">重新整理分析</button></view>
  <view wx:elif="{{cardsLoading}}" class="card muted"><text>正在整理分析…</text></view>
  <block wx:else>
    <view wx:if="{{cards.length === 0}}" class="empty"><image class="empty-cat" src="/assets/stickers/journal.png" mode="aspectFit" aria-hidden="true"/><text class="empty-title">还没有可展示的分析</text>录入物品后，这里会整理保修、使用和费用信息。</view>
    <view wx:for="{{cards}}" wx:key="key" class="card analysis-card analysis-{{item.kind}}"><view class="analysis-label"><view class="analysis-dot"></view><text>{{item.label}}</text></view><view class="headline">{{item.headline}}</view><view class="analysis-basis"><text class="basis-label">计算依据</text><view>{{item.explanation}}</view></view><view wx:if="{{item.items.length}}" class="links"><view wx:for="{{item.items}}" wx:for-item="entry" wx:key="id" class="link" data-id="{{entry.id}}" bindtap="open"><text>{{entry.icon}}</text><text class="link-name">{{entry.name}}</text><text class="link-arrow">›</text></view></view></view>
  </block>
  <view class="section-head monthly-section-head"><text class="section-title">本月记录</text><button class="journal-link" bindtap="monthlyReport">收藏小报 ›</button></view>
  <view wx:if="{{monthlyLoading}}" class="card muted">正在整理本月记录…</view>
  <view wx:elif="{{monthlyError}}" class="card error-panel">{{monthlyError}}<button class="button light" bindtap="loadMonthly">重新读取本月</button></view>
  <block wx:elif="{{monthly}}"><view class="card monthly-brief"><view class="journal-caption">{{monthly.month}} · 截至 {{monthly.cutoff_date}}</view><view>购入 {{monthly.totals.purchase_count}} 件 · 记录使用 {{monthly.totals.usage_count}} 次</view><view class="journal-note">购置 ¥{{monthly.totals.purchase_total}} / 维修 ¥{{monthly.totals.maintenance_total}} / 回收 ¥{{monthly.totals.disposal_total}}</view></view>
  <view class="section-head"><text class="section-title">本月陪伴</text></view><view wx:if="{{!monthly.memories.length}}" class="journal-note">本月还没有达成的纪念。</view><view wx:for="{{monthly.memories}}" wx:key="key" class="card" data-id="{{item.item_id}}" bindtap="open"><view class="journal-caption">{{item.date}} · {{item.label}}</view><view class="journal-entry-name">{{item.name}} ›</view></view></block>
  <view class="analysis-note">使用记录可能不完整，分析只供核对，不会自动改变物品状态。</view>
</view>
